# StratumWeb Backend Configuration
# Copy this file to .env and fill in the values

# Admin Access Password
ADMIN_PASSWORD=stratum_admin

# Database Settings (Defaults to local leads.db)
# DATABASE_URL=sqlite:///leads.db

# Email Notification Settings (Gmail Recommended)
# To use Gmail, you MUST create an "App Password" here: 
# https://myaccount.google.com/apppasswords
SENDER_EMAIL=startumweb@gmail.com
SENDER_PASSWORD=
RECEIVER_EMAIL=startumweb@gmail.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
